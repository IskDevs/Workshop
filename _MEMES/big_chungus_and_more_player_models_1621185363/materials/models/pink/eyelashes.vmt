
"VertexLitGeneric"
{
    "$baseTexture" "models\sierra\Pink_Guy_Body_diffuse" //diffuse texture, translucency in alpha
    
    "$bumpmap" "models\sierra\Pink_Guy_Body_normal" //normal texture, specular map in alpha
            

    "$phong" "1" //specular phong info
    "$phongboost" "1" //specular phong info
    "$phongexponent" "25" //specular phong info
    "$phongfresnelranges"  "[.5 1.5 2]" //specular phong info

    "$surfaceprop" "default"

    "$rimlight" "1" //specular phong info related to rimlight
    "$rimlightexponent" "2" //specular phong info related to rimlight
    "$rimlightboost" "1.5" //specular phong info related to rimlight
    
    "$ambientocclusion" 0
    "$alphatest" "1" //enables translucency (we dont use $translucent because of z-fighting and shadows don't work with non-binary alphas)
    "$nocull" 1 //good for hair, textures will not cull on the other side of a poly' 
            
}
        